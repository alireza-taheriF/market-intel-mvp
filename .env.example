# --- AI model (required for the analysis) ---
LLM_PROVIDER=auto           # auto | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5     # used when LLM_PROVIDER=anthropic
LLM_EFFORT=medium            # low | medium | high (reasoning effort, both providers)
LLM_TIMEOUT_S=180
LLM_REFUSAL_FALLBACKS=true   # Claude only: server-side fallback if the model declines

# --- Web search ---
SEARCH_PROVIDER=auto         # auto | tavily | duckduckgo  (auto = tavily if a key is set)
TAVILY_API_KEY=
HTTP_TIMEOUT_S=12
RESULTS_PER_QUERY=6
MAX_PAGES_PER_STEP=12
SEARCH_DELAY_S=1.5           # pause between keyless DuckDuckGo queries (rate limits)

# --- Test email (SMTP). Recipient is hard-coded to behta.technicalteam@gmail.com ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls       # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_S=20

RUNS_DIR=runs
